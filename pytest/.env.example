# Copie este arquivo para ".env" e preencha.

# API sob teste (local: http://127.0.0.1:8000)
BASE_URL=https://valletapi.onrender.com

# Motorista de teste (se não existir, a suíte cria via cadastro público)
MOTORISTA_EMAIL=teste_motorista@gmail.com
MOTORISTA_SENHA=teste123

# Admin SEM estacionamento vinculado (o CT-13 cria o estacionamento para ele)
ADMIN_EMAIL=
ADMIN_SENHA=

# Superadmin
SUPER_EMAIL=
SUPER_SENHA=

# Timeout (segundos) das requisições; aumente se a API estiver "dormindo"
TIMEOUT=90
